{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "KERNEL_LOAD_PHY_ADDR_START=0",
                "KERNEL_LOAD_VIRT_ADDR_START=0",
                "KERNEL_LOAD_VIRT_ADDR_OFFSET=0",
                "KERNEL_SHADOW_VIRT_ADDR_OFFSET=0"
            ],
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerArgs": [
                "-ffreestanding",
                "-nostdinc",
                "-nostdlib",
                "-m64",
                "-mno-avx",
                "-mno-avx2",
                "-fno-pic",
                "-fno-pie",
                "-fno-stack-protector",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/src/kernel",
                "-I${workspaceFolder}/src/kernel/include"
            ]
        }
    ],
    "version": 4
}